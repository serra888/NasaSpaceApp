APP_NAME=Orbiton
DATABASE_URL=postgresql+psycopg://orbiton:orbiton_local@localhost:5432/orbiton
TEST_DATABASE_URL=postgresql+psycopg://orbiton:orbiton_local@localhost:5432/orbiton_test
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
MISSION_TIMEZONE=UTC
DEMO_ASTRONAUT_ID=orbiton-demo
SIMULATOR_INTERVAL_SECONDS=5
MEASUREMENT_STALE_SECONDS=30
CHECKIN_STALE_HOURS=24
# Optional AI service implementing docs/api/ai-contract.md. Empty URL enables fallback.
AI_SERVICE_URL=
# Optional service-to-service bearer token; never exposed to the browser.
AI_SERVICE_TOKEN=
AI_TIMEOUT_SECONDS=8
# Reserved for the AI developer's provider client. Backend does not call a provider directly.
OPENAI_API_KEY=

# Keep 1.0 until the AI service supports 1.1.
AI_CONTRACT_VERSION=1.0
AI_TREND_WINDOW_DAYS=3
