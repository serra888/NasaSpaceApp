# Backend only. Never expose this value in frontend code or commit a real key.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key

# Stable free-tier model with structured-output support.
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=3001
GEMINI_TIMEOUT_MS=8000

# Optional shared secret. Set the same value as backend AI_SERVICE_TOKEN.
AI_SERVICE_TOKEN=
